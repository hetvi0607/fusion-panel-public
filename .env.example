# GitHub API credentials
GITHUB_TOKEN=your_github_personal_access_token

# Repository configurations are now stored in SQLite database (repositories.db)
# Use the following commands to manage repositories:
#   python migrate_to_db.py           - Migrate from .env to database
#   python manage_repos.py list       - List all repositories
#   python manage_repos.py add <repo> <branch>  - Add a new repository
# 
# Legacy (for migration only - will be removed in future versions):
# GITHUB_REPOS=organization/repo-name-x,organization/repo-name-y
# GITHUB_REPOS_BRANCHES=org/repo1:branch1,org/repo2:branch2

# Claude API credentials
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Sheets API credentials
GOOGLE_CREDENTIALS_FILE=credentials.json

# Email settings
EMAIL_SENDER=sender@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=recipient@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# WhatsApp Business API settings
WHATSAPP_ENABLED=False
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Comma-separated list of WhatsApp group/recipient IDs (phone numbers in international format without +)
WHATSAPP_GROUP_IDS=YOUR_RECIPIENT_ID

# AI analysis settings
AI_ENABLED=True
AI_SUMMARY_MIN_WORDS=50
AI_SUMMARY_MAX_WORDS=150
AI_MAX_TOKENS=100000
AI_RATE_LIMIT=50
AI_BUDGET_LIMIT=50.0

# Performance settings
BATCH_SIZE=100
PARALLEL_PROCESSING=True
MAX_WORKERS=5

# Environment (development/production)
ENVIRONMENT=development
